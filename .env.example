# Bestehende Variablen (Namen auf Railway unverändert)
TELEGRAM_TOKEN=your-telegram-bot-token
NOTION_TOKEN=your-notion-integration-token
NOTION_DATABASE_ID=your-notion-database-id

# Neu
OPENROUTER_API_KEY=your-openrouter-api-key
# Komma-getrennte Telegram-User-IDs, die den Bot nutzen dürfen.
# Leer lassen, dann nennt der Bot jedem nur dessen eigene ID.
ALLOWED_USER_IDS=

# Web-App: wer sich anmelden darf, als name:schlüssel (mehrere mit Komma).
# Erzeugen mit: python -m koch_guru.web.keys philip charlotte
APP_USERS=

# Optional
# PORT=8000
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# RECIPE_CACHE_SECONDS=300
# NOTION_PROP_LINK=Link
# NOTION_PROP_TAGS=Tags
